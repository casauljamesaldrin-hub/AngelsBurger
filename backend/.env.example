NODE_ENV="development"
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/angels_burger"
JWT_SECRET="replace-with-at-least-32-random-characters"
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"

# Brevo (optional for local inventory work; required to actually send email)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Angels Burger Inventory System"
BREVO_REPLY_TO_EMAIL=""

# Secret that your scheduler sends in the x-job-secret header (16+ chars)
JOB_SECRET=""

# Where product images are stored. LOCAL DISK ONLY - see README before deploying.
UPLOAD_DIR="uploads"

# First admin (used by `npm run create-admin` / `npm run seed`)
ADMIN_EMAIL=""
ADMIN_NAME="Store Admin"
ADMIN_PASSWORD=""
# Set to "true" to add clearly labeled SAMPLE ingredients/products. Never in production.
SEED_SAMPLE_DATA="false"
