import { useState } from 'react';
import { NavLink, Outlet, useLocation } from 'react-router-dom';
import { Boxes, ClipboardList, History, LayoutDashboard, LogOut, Mail, Menu, ReceiptText, ScrollText, Settings, Users, UtensilsCrossed, BarChart3 } from 'lucide-react';
import { useAuth } from '../lib/auth';

const items = [
  { to: '/', label: 'Dashboard', icon: LayoutDashboard },
  { to: '/orders', label: 'Orders and sales', icon: ReceiptText },
  { to: '/menu', label: 'Menu and recipes', icon: UtensilsCrossed },
  { to: '/inventory', label: 'Inventory', icon: Boxes },
  { to: '/transactions', label: 'Stock history', icon: History },
  { to: '/reports', label: 'Reports', icon: BarChart3, admin: true },
  { to: '/email', label: 'Email', icon: Mail, admin: true },
  { to: '/staff', label: 'Staff', icon: Users, admin: true },
  { to: '/audit', label: 'Audit log', icon: ScrollText, admin: true },
  { to: '/settings', label: 'Settings', icon: Settings, admin: true },
];

export default function AppLayout() {
  const { me, logout } = useAuth();
  const [open, setOpen] = useState(false);
  useLocation();
  const nav = (
    <nav className="flex flex-col gap-0.5 p-3" aria-label="Main">
      {items.filter((i) => !i.admin || me?.role === 'ADMIN').map(({ to, label, icon: Icon }) => (
        <NavLink key={to} to={to} end={to === '/'} onClick={() => setOpen(false)}
          className={({ isActive }) => `flex items-center gap-3 rounded-md px-3 py-2 text-sm ${isActive ? 'bg-bun text-ink font-semibold' : 'text-neutral-200 hover:bg-white/10'}`}>
          <Icon size={18} />{label}
        </NavLink>
      ))}
    </nav>
  );
  return (
    <div className="min-h-screen lg:flex">
      <aside className="hidden lg:flex lg:w-60 shrink-0 flex-col bg-ink text-white sticky top-0 h-screen">
        <div className="px-5 py-4 font-display text-xl font-bold">Angels Burger</div>
        <div className="flex-1 overflow-y-auto">{nav}</div>
        <div className="p-3 border-t border-white/10 text-sm">
          <p className="truncate font-medium">{me?.name}</p><p className="text-xs text-neutral-400">{me?.role === 'ADMIN' ? 'Admin' : 'Staff'}</p>
          <button className="mt-2 flex items-center gap-2 text-neutral-300 hover:text-white" onClick={logout}><LogOut size={16} />Sign out</button>
        </div>
      </aside>
      <div className="lg:hidden flex items-center justify-between bg-ink text-white px-4 py-3 sticky top-0 z-40">
        <button onClick={() => setOpen(true)} aria-label="Open menu"><Menu /></button>
        <span className="font-display font-bold">Angels Burger</span>
        <button onClick={logout} aria-label="Sign out"><LogOut size={20} /></button>
      </div>
      {open && (
        <div className="lg:hidden fixed inset-0 z-50 flex" onClick={() => setOpen(false)}>
          <div className="w-64 bg-ink text-white overflow-y-auto" onClick={(e) => e.stopPropagation()}>{nav}</div>
          <div className="flex-1 bg-black/40" />
        </div>
      )}
      <main className="flex-1 min-w-0 p-4 lg:p-6"><Outlet /></main>
    </div>
  );
}
